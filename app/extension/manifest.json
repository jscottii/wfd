{
  "manifest_version": 3,
  "name": "WFD – Save recipes",
  "short_name": "WFD",
  "version": "1.1.0",
  "description": "Save the recipe on any page to WFD — What's for Dinner, with its shopping list items, in one click.",
  "homepage_url": "https://wfdmeals.app/",
  "action": { "default_popup": "popup.html", "default_title": "Save this recipe to WFD", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+W" }, "description": "Save this recipe to WFD" } }
}
